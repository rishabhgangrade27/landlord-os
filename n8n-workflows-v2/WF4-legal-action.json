    {
      "parameters": {
        "jsCode": "// Gather data from all prior nodes\nconst tenant = $('Fetch Tenant').first().json;\nconst leaseItems = $('Fetch Active Lease').all();\nconst lease = leaseItems.length > 0 ? leaseItems[0].json : {};\nconst courtLedgerItems = $('Fetch Court Ledger').all();\nconst yearlyItems = $('Fetch Yearly Payments').all();\nconst yearly = yearlyItems.length > 0 ? yearlyItems[0].json : {};\nconst templateItems = $('Fetch Legal Template').all();\nconst template = templateItems.length > 0 ? templateItems[0].json : {};\n\nif (!template.body) {\n  throw new Error('No active legal template found for notice_type: ' + ($('Webhook — Legal Action').first().json.body.notice_type || 'unknown'));\n}\n\n// Build check detail list from court ledger rows\nconst checkDetails = courtLedgerItems.map(function(item) {\n  var row = item.json;\n  var line = '';\n  if (row.check_date) line += 'Date: ' + row.check_date;\n  if (row.check_number) line += ' | Check #: ' + row.check_number;\n  if (row.amount) line += ' | Amount: $' + Number(row.amount).toFixed(2);\n  if (row.status) line += ' | Status: ' + row.status;\n  return line;\n}).join('\\n');\n\n// Date calculations\nvar now = new Date();\nvar cureByDate = new Date(now.getTime() + 14 * 24 * 60 * 60 * 1000);\nvar vacateByDate = new Date(now.getTime() + 90 * 24 * 60 * 60 * 1000);\n\nfunction formatDate(d) {\n  return (d.getMonth() + 1) + '/' + d.getDate() + '/' + d.getFullYear();\n}\n\n// Generate reference_id\nvar pad = function(n) { return n < 10 ? '0' + n : '' + n; };\nvar referenceId = 'LN-' + now.getFullYear() + pad(now.getMonth() + 1) + pad(now.getDate()) + '-' + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());\n\n// Build placeholder map\nvar placeholders = {\n  'tenant_name': (tenant.first_name || '') + ' ' + (tenant.last_name || ''),\n  'tenant_first_name': tenant.first_name || '',\n  'tenant_last_name': tenant.last_name || '',\n  'tenant_email': tenant.email || '',\n  'tenant_phone': tenant.phone || '',\n  'unit_number': lease.unit_number || tenant.unit_number || '',\n  'property_address': lease.property_address || tenant.property_address || '',\n  'monthly_rent': lease.monthly_rent ? '$' + Number(lease.monthly_rent).toFixed(2) : '',\n  'lease_start': lease.start_date || '',\n  'lease_end': lease.end_date || '',\n  'total_owed': yearly.total_owed ? '$' + Number(yearly.total_owed).toFixed(2) : '',\n  'total_paid': yearly.total_paid ? '$' + Number(yearly.total_paid).toFixed(2) : '',\n  'balance_due': yearly.balance_due ? '$' + Number(yearly.balance_due).toFixed(2) : '',\n  'check_details': checkDetails || 'No check records found.',\n  'cure_by_date': formatDate(cureByDate),\n  'vacate_by_date': formatDate(vacateByDate),\n  'notice_date': formatDate(now),\n  'reference_id': referenceId,\n  'attorney_name': tenant.attorney_name || '',\n  'attorney_email': tenant.attorney_email || ''\n};\n\n// Fill template using split/join\nvar rendered = template.body;\nObject.keys(placeholders).forEach(function(key) {\n  rendered = rendered.split('{{' + key + '}}').join(placeholders[key]);\n});\n\nreturn [{\n  json: {\n    rendered_text: rendered,\n    reference_id: referenceId,\n    tenant_id: tenant.id,\n    property_id: lease.property_id || tenant.property_id || null,\n    notice_type: $('Webhook — Legal Action').first().json.body.notice_type,\n    template_id: template.id || null,\n    attorney_email: tenant.attorney_email || null,\n    generated_at: now.toISOString(),\n    cure_by_date: cureByDate.toISOString(),\n    vacate_by_date: vacateByDate.toISOString()\n  }\n}];"
      },
