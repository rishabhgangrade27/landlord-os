    {
      "parameters": {
        "jsCode": "const tenant = $('Fetch Tenant').first().json;\nconst lease = $('Fetch Active Lease').first().json;\nconst checks = $('Fetch Court Ledger').all().map(i => i.json);\nconst yearly = $('Fetch Yearly Summary').first().json;\nconst template = $('Fetch Template').first().json;\n\nif (!tenant || !lease || !template) {\n  throw new Error('Missing data: tenant, lease, or template');\n}\n\nconst today = new Date().toLocaleDateString('en-US', {\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric'\n});\n\nconst checkList = checks\n  .map(c => `${c.month_label} — Check #${c.check_number} (${c.check_date}) — \\$${parseFloat(c.amount || 0).toFixed(2)}`)\n  .join('\\n');\n\nconst checkDates = checks.map(c => c.check_date).filter(Boolean).sort();\nconst periodStart = checkDates[0] || '—';\nconst periodEnd = checkDates[checkDates.length - 1] || '—';\n\nconst outstandingBalance = parseFloat(yearly?.total_balance || 0).toFixed(2);\nconst totalDue = parseFloat(yearly?.total_due || 0).toFixed(2);\nconst totalPaid = parseFloat(yearly?.total_paid || 0).toFixed(2);\nconst monthlyRent = parseFloat(lease?.rent_amount || 0).toFixed(2);\n\nlet rendered = template.body\n  .replace(/{{notice_date}}/g, today)\n  .replace(/{{tenant_name}}/g, tenant.full_legal_name || tenant.name)\n  .replace(/{{case_number}}/g, tenant.case_number || '—')\n  .replace(/{{property_address}}/g, tenant.address || '—')\n  .replace(/{{unit_number}}/g, lease.unit_number || '—')\n  .replace(/{{monthly_rent}}/g, `\\$${monthlyRent}`)\n  .replace(/{{outstanding_balance}}/g, `\\$${outstandingBalance}`)\n  .replace(/{{total_due}}/g, `\\$${totalDue}`)\n  .replace(/{{total_paid}}/g, `\\$${totalPaid}`)\n  .replace(/{{period_start}}/g, periodStart)\n  .replace(/{{period_end}}/g, periodEnd)\n  .replace(/{{check_detail_list}}/g, checkList || '(No checks recorded)')\n  .replace(/{{lease_start}}/g, lease.start_date || '—')\n  .replace(/{{lease_end}}/g, lease.end_date || '—');\n\nconst referenceId = `LN-${Date.now()}`;\n\nreturn [{\n  json: {\n    rendered_text: rendered,\n    reference_id: referenceId,\n    tenant_id: tenant.id,\n    lease_id: lease.id,\n    unit_id: lease.unit_id,\n    property_id: lease.property_id,\n    notice_type: $('Webhook — Legal Action').first().json.notice_type,\n    status: 'generated'\n  }\n}];"
      },
