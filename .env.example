# Local Postgres connection (Step 2 of INSTALL-GUIDE.md sets this password)
DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/landlordos

# Local auth — generate fresh values per machine, never copy from another .env.local
# Generate SESSION_SECRET with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=generate-a-fresh-random-value-per-machine
# Generate ADMIN_PASSWORD_HASH with: node scripts/set-password.js "your-password-here"
ADMIN_PASSWORD_HASH=

# Cron auth — shared secret so Windows Task Scheduler can call /api/cron/* routes
# without a browser session cookie. Generate fresh per machine, e.g.:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=generate-a-fresh-random-value-per-machine

# Legal notice PDF generation (used by some older notice types only —
# the real .docx templates don't need this)
HTML2PDF_API_KEY=

# Legacy — only used one-time by scripts/migrate-to-postgres.js to pull the
# original data out of Supabase. Not needed for normal day-to-day running.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
